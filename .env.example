# Database
DB_PASSWORD=your-secure-db-password

# Redis
REDIS_CONNECTION=georisk-redis:6379

# JWT
JWT_SECRET=your-secret-key-at-least-32-characters-long
JWT_ISSUER=GeoRisk.API
JWT_AUDIENCE=GeoRisk.Web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# SonarQube
SONAR_DB_PASSWORD=your-sonar-db-password

# AI Providers - LLM Configuration
# Primary: DeepSeek (free tier available)
# Fallback: Ollama (self-hosted), Qwen, Anthropic, OpenAI

# LLM Provider selection: DeepSeek, Ollama, Qwen, Anthropic, OpenAI
LLM_PROVIDER=DeepSeek

# DeepSeek API (primary - free tier available at https://platform.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Ollama (self-hosted local models - no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Qwen/Alibaba Cloud (alternative)
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen-turbo

# Legacy providers (still supported)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# CORS
CORS_FRONTEND_ORIGIN=http://localhost:3000

# OpenRouteService (routing via real roads)
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key

# OSRM Routing (self-hosted)
NEXT_PUBLIC_OSRM_URL=http://localhost:5001