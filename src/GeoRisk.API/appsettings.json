{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=georisk;Username=georisk"
  },
  "Jwt": {
    "Issuer": "GeoRisk.API",
    "Audience": "GeoRisk.Web",
    "SecretKey": "DevOnly_ReplaceWithSecureKeyInProduction_Min32Chars!",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379"
  }
}
